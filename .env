# Server
PORT=3000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/gamification

# Headers
TENANT_HEADER=x-tenant-id

# REST dev API key (optional for local testing)
API_KEY=dev-api-key

# WebSocket
REALTIME_DEV_API_KEY=dev-api-key
REALTIME_MAX_EVENTTYPES=50
REALTIME_MAX_CLIENTS=1000

# Webhooks
WEBHOOK_TIMEOUT_MS=5000

# CORS
CORS_ORIGIN=*

# S3 (avatar storage)
# Configure com seus dados de S3/MinIO. Para MinIO local, use o endpoint abaixo.
S3_BUCKET=your-bucket
S3_REGION=us-east-1
# Opcional para MinIO ou endpoint customizado
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
# Necessário para MinIO (path-style URLs)
S3_FORCE_PATH_STYLE=true

# Player Avatars (limites e validações)
# Tipos de imagem permitidos (comma-separated)
PLAYER_AVATAR_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp
# Dimensões permitidas (comma-separated WxH)
PLAYER_AVATAR_ALLOWED_SIZES=128x128,256x256,512x512
# Tamanho máximo do arquivo, em MB
PLAYER_AVATAR_MAX_SIZE_MB=2

# Auth (Player)
# Segredo e validade do JWT emitido para jogadores
PLAYER_JWT_SECRET=dev-player-secret
PLAYER_JWT_EXPIRES=1h

# Auth (Client)
# Segredo e validade do JWT emitido para clientes (SDK/Admin)
CLIENT_JWT_SECRET=dev-client-secret
CLIENT_JWT_EXPIRES_IN=1h

# Email
# Provedor de envio de email: "console" (log), "resend" (produção)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@example.com
# Necessário quando EMAIL_PROVIDER=resend
RESEND_API_KEY=your-resend-api-key

# Public URL
# Usado na geração de links de verificação/reset em emails
PUBLIC_URL=http://localhost:3000

# Rate Limits
# Limites padrão de requisições por tenant e por player
TENANT_RPS_DEFAULT=300
PLAYER_RPS_DEFAULT=300